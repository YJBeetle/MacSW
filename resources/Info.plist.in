<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleExecutable</key>
    <string>MacSW</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.yjbeetle.macsw</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MacSW</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>SOLIDWORKS Part</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>com.yjbeetle.macsw.solidworks-part</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>SOLIDWORKS Assembly</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>com.yjbeetle.macsw.solidworks-assembly</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>SOLIDWORKS Drawing</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>com.yjbeetle.macsw.solidworks-drawing</string></array>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.yjbeetle.macsw.solidworks-part</string>
            <key>UTTypeDescription</key>
            <string>SOLIDWORKS Part</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict><key>public.filename-extension</key><array><string>sldprt</string></array></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.yjbeetle.macsw.solidworks-assembly</string>
            <key>UTTypeDescription</key>
            <string>SOLIDWORKS Assembly</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict><key>public.filename-extension</key><array><string>sldasm</string></array></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.yjbeetle.macsw.solidworks-drawing</string>
            <key>UTTypeDescription</key>
            <string>SOLIDWORKS Drawing</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict><key>public.filename-extension</key><array><string>slddrw</string></array></dict>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>@APP_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@APP_BUILD@</string>
    <key>MacSWWineVersion</key>
    <string>@WINE_VERSION@</string>
    <key>MacSWMonoVersion</key>
    <string>@WINE_MONO_VERSION@</string>
    <key>MacSWMonoPatchSHA256</key>
    <string>@MONO_PATCH_SHA256@</string>
    <key>MacSWMonoMscorlibSHA256</key>
    <string>@MONO_MSCORLIB_SHA256@</string>
    <key>MacSWMonoRegAsmX86SHA256</key>
    <string>@MONO_REGASM_X86_SHA256@</string>
    <key>MacSWMonoRegAsmX64SHA256</key>
    <string>@MONO_REGASM_X64_SHA256@</string>
    <key>MacSWStdoleVersion</key>
    <string>@STDOLE_VERSION@</string>
    <key>MacSWStdoleSHA256</key>
    <string>@STDOLE_DLL_SHA256@</string>
    <key>LSMinimumSystemVersion</key>
    <string>@MACOS_DEPLOYMENT_TARGET@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>SUFeedURL</key>
    <string>https://github.com/YJBeetle/MacSW/releases/latest/download/appcast.xml</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUSendProfileInfo</key>
    <false/>
    <key>NSAppleEventsUsageDescription</key>
    <string>MacSW 需要打开 macOS 终端，以便在当前 Wine 容器中运行交互式 CMD。</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>
</dict>
</plist>
