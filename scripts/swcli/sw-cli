#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTENTS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
WINE_ROOT="${CONTENTS_DIR}/Frameworks/wine"
WINELOADER="${WINE_ROOT}/bin/wineloader"
WINESERVER="${WINE_ROOT}/bin/wineserver"
SWCLI_RESOURCES="${CONTENTS_DIR}/Resources/SWCLI"
WINEPREFIX="${MACSW_WINEPREFIX:-${HOME}/Library/Application Support/MacSW/bottle}"
WINDOWS_PYTHON='C:\MacSW\Python311\python.exe'
PYTHON_UNIX="${WINEPREFIX}/drive_c/MacSW/Python311/python.exe"

export WINEPREFIX
export WINEDEBUG="${WINEDEBUG:--all}"

to_windows_path() {
    printf 'Z:%s\n' "${1//\//\\}"
}

if [ ! -x "${WINELOADER}" ] || [ ! -x "${WINESERVER}" ]; then
    echo "MacSW Wine runtime is incomplete: ${WINE_ROOT}" >&2
    exit 1
fi
if [ ! -f "${PYTHON_UNIX}" ]; then
    echo "SWCLI runtime is not installed in this MacSW bottle; reinstall SOLIDWORKS with MacSW." >&2
    exit 1
fi

SWCLI_PATH_HELPER_WIN="$(to_windows_path "${SWCLI_RESOURCES}/bin/swcli_path.exe")"
export SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
export SWCLI_HOST_PLATFORM="macos-wine"
export SWCLI_PATH_TRANSLATE_CMD="${SWCLI_PATH_HELPER_WIN}"
export SWCLI_POSIX_CWD_WIN="$(to_windows_path "${PWD}")"

# MacSW is an interactive desktop host. Typed operations intentionally share
# the already-open SOLIDWORKS instance instead of invoking SWCLI's exclusive
# default host policy.
case "${1:-}" in
    document|part)
        "${WINELOADER}" "${WINDOWS_PYTHON}" -m swcli daemon start \
            --visible --attach-existing --json >/dev/null
        ;;
esac

exec "${WINELOADER}" "${WINDOWS_PYTHON}" -m swcli "$@"
