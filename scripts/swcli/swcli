#!/usr/bin/env bash
set -euo pipefail

# A PATH entry can be an absolute or relative chain of symbolic links.
# Resolve the launcher itself before locating the sealed App resources.
SOURCE="${BASH_SOURCE[0]}"
LINK_COUNT=0
while [ -L "${SOURCE}" ]; do
    LINK_COUNT=$((LINK_COUNT + 1))
    if [ "${LINK_COUNT}" -gt 40 ]; then
        echo "MacSW swcli symbolic link chain is too long." >&2
        exit 1
    fi
    SOURCE_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(/usr/bin/readlink "${SOURCE}")"
    case "${SOURCE}" in
        /*) ;;
        *) SOURCE="${SOURCE_DIR}/${SOURCE}" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
CONTENTS_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
# Native client only: no public arguments are interpreted in shell.
SWCLI_RESOURCES="${CONTENTS_DIR}/Resources/SWCLI"
NATIVE_PYTHON="${SWCLI_RESOURCES}/runtime/PythonNative/bin/python3"
NATIVE_PATH_HELPER="${SWCLI_RESOURCES}/bin/swcli-path"
if [ ! -x "${NATIVE_PYTHON}" ] || [ ! -x "${NATIVE_PATH_HELPER}" ]; then
    echo "MacSW native SWCLI runtime is incomplete; reinstall MacSW." >&2
    exit 1
fi
export WINEPREFIX="${MACSW_WINEPREFIX:-${HOME}/Library/Application Support/MacSW/bottle}"
export SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
export SWCLI_HOST_PLATFORM="macos-wine"
export SWCLI_DAEMON_UTILS="${SWCLI_DAEMON_UTILS:-${SWCLI_RESOURCES}/bin/swcli-daemon-utils}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${SWCLI_RESOURCES}/runtime/PythonNative/lib/python3.11/site-packages"
export SWCLI_PATH_TRANSLATE_CMD="${NATIVE_PATH_HELPER}"
exec "${NATIVE_PYTHON}" -B -m swcli "$@"
