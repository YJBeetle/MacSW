+/***********************************************************************
+ *              macdrv_set_view_clip
+ *
+ * Clips a client surface view to an array of rectangles.  If rects is
+ * NULL, resets the view's clip to its bounds.
+ */
+void macdrv_set_view_clip(WineContentView *v, const CGRect *rects, int count)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    OnMainThread(^{
+        CALayer* layer = [view layer];
+        CAShapeLayer* mask = (CAShapeLayer*)[layer mask];
+        CGMutablePathRef path = NULL;
+        BOOL hidden = rects && !count;
+        unsigned int i;
+
+        if (rects)
+        {
+            path = CGPathCreateMutable();
+            for (i = 0; i < count; i++)
+            {
+                CGRect rect = cgrect_mac_from_win(rects[i]);
+                CGPathAddRect(path, NULL, rect);
+            }
+        }
+
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (path)
+        {
+            if (!mask) [layer setMask:mask = [CAShapeLayer layer]];
+            [mask setContentsScale:[layer contentsScale]];
+            [mask setFrame:[layer bounds]];
+            if (!CGPathEqualToPath(path, [mask path])) [mask setPath:path];
+        }
+        else if (mask) [layer setMask:nil];
+        [view setHidden:hidden];
+        [CATransaction commit];
+        [(WineWindow*)view.window updateForGLSubviews];
+        if (path) CGPathRelease(path);
+    });
+}
+}
