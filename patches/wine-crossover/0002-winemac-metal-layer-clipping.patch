+    BOOL offscreen = NtUserGetAncestor(hwnd, GA_PARENT) != NtUserGetDesktopWindow();
+    HDC hdc;

     TRACE("%s\n", debugstr_client_surface(client));

+    InterlockedExchange(&client->offscreen, offscreen);
     if (!(data = get_win_data(toplevel))) return;
     macdrv_set_view_frame(surface->cocoa_view, cgrect_from_rect(client->monitor_rect));
     macdrv_set_view_superview(surface->cocoa_view, toplevel == hwnd ? NULL : data->client_view, data->cocoa_window, NULL, NULL);
     release_win_data(data);
+    if (offscreen && (hdc = NtUserGetDCEx(hwnd, 0, DCX_CACHE | DCX_USESTYLE)))
+    {
+        macdrv_client_surface_update_clip(surface, hdc);
+        NtUserReleaseDC(hwnd, hdc);
+    }
 }

