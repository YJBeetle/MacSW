+/***********************************************************************
+ *              macdrv_set_view_clip
+ *
+ * Clips a client surface view to an array of rectangles.  If rects is
+ * NULL, resets the view's clip to its bounds.
+ */
+void macdrv_set_view_clip(macdrv_view v, const CGRect *rects, int count)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    CGMutablePathRef path = NULL;
+    unsigned int i;
+
+    if (rects)
+    {
+        path = CGPathCreateMutable();
+        for (i = 0; i < count; i++)
+            CGPathAddRect(path, NULL, cgrect_mac_from_win(rects[i]));
+    }
+
+    OnMainThread(^{
+        CALayer* layer = [view layer];
+        CAShapeLayer* mask = (CAShapeLayer*)[layer mask];
+
+        if ((!path && !mask) || (path && mask && CGPathEqualToPath(path, [mask path]))) return;
+
+        if (path && !mask)
+            [layer setMask:mask = [CAShapeLayer layer]];
+        else if (!path)
+            [layer setMask:mask = nil];
+
+        [mask setContentsScale:[layer contentsScale]];
+        [mask setFrame:[layer bounds]];
+        [mask setPath:path];
     });
+
+    if (path) CGPathRelease(path);
 }
 }
 
