+static void macdrv_client_surface_update_clip(struct macdrv_client_surface *surface, HDC hdc)
+{
+    struct client_surface *client = &surface->client;
+    HRGN clip_region;
+    RGNDATA *clip_data;
+
+    if (!surface->clip_region || !hdc) return;
+    if ((clip_region = NtGdiCreateRectRgn(0, 0, 0, 0)))
+    {
+        if (NtGdiGetRandomRgn(hdc, clip_region, SYSRGN | NTGDI_RGN_MONITOR_DPI) <= 0)
+        {
+            if (surface->clip_region_valid)
+            {
+                macdrv_set_view_clip(surface->cocoa_view, NULL, 0);
+                surface->clip_region_valid = FALSE;
+                surface->clip_rect_valid = FALSE;
+            }
+        }
+        else
+        {
+            if ((!surface->clip_region_valid || !NtGdiEqualRgn(clip_region, surface->clip_region) ||
+                 !surface->clip_rect_valid || !EqualRect(&client->monitor_rect, &surface->clip_rect)) &&
+                (clip_data = get_region_data(clip_region, 0)))
+            {
+                macdrv_set_view_clip(surface->cocoa_view, (CGRect *)clip_data->Buffer, clip_data->rdh.nCount);
+                NtGdiCombineRgn(surface->clip_region, clip_region, 0, RGN_COPY);
+                surface->clip_rect = client->monitor_rect;
+                surface->clip_region_valid = TRUE;
+                surface->clip_rect_valid = TRUE;
+                free(clip_data);
+            }
+        }
+        NtGdiDeleteObjectApp(clip_region);
+    }
+}
