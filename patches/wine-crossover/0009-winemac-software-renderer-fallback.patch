+        WARN("Accelerated legacy pixel format unavailable (%d); trying Apple software renderer\n", err);
+        if (pix) CGLReleasePixelFormat(pix);
+        pix = NULL;
+        attribs[0] = kCGLPFARendererID;
+        attribs[1] = kCGLRendererGenericFloatID;
+        attribs[2] = kCGLPFAOpenGLProfile;
+        attribs[3] = (CGLPixelFormatAttribute)profile;
