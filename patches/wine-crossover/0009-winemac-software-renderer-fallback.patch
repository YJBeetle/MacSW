+    else if (!strcmp(selection, "software")) force_software_renderer = TRUE;
+    else
+    {
+        WARN("Invalid MACSW_OPENGL_RENDERER '%s'; expected auto or software\n", selection);
+        return FALSE;
+    }
+    return TRUE;
+}
