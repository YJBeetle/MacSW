+/* If the Cocoa input source has a pending composition, Space belongs to the
+ * candidate UI even while SOLIDWORKS' graphics view has Windows focus. */
+bool macdrv_ime_has_marked_text(void)
+{
+    __block bool marked = true; /* Missing Wine window: keep normal IME handling. */
+
+    OnMainThread(^{
+        WineWindow* window = (WineWindow*)[NSApp keyWindow];
+        if (![window isKindOfClass:[WineWindow class]])
+        {
+            window = (WineWindow*)[NSApp mainWindow];
+            if (![window isKindOfClass:[WineWindow class]])
+                window = [[WineApplicationController sharedController] frontWineWindow];
+        }
+        if (window)
+            marked = [[window contentView] hasMarkedText];
+    });
+    return marked;
+}
