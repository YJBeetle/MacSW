diff --git a/include/wine/native_file_manager.h b/include/wine/native_file_manager.h
new file mode 100644
--- /dev/null
+++ b/include/wine/native_file_manager.h
@@ -0,0 +1,41 @@
+/* MacSW's opt-in bridge for filesystem folders. No command shell is used. */
+#ifndef __WINE_NATIVE_FILE_MANAGER_H
+#define __WINE_NATIVE_FILE_MANAGER_H
+
+#include "winternl.h"
+
+static BOOL wine_native_file_manager_enabled(void)
+{
+    WCHAR enabled[2];
+    return GetEnvironmentVariableW( L"MACSW_NATIVE_FILE_MANAGER", enabled, ARRAY_SIZE(enabled) ) == 1 &&
+           enabled[0] == '1';
+}
+
+static BOOL wine_open_native_file_manager( const WCHAR *path, BOOL select )
+{
+    DWORD attributes;
+    char *unix_path;
+    char *reveal[] = { "/usr/bin/open", "-R", "--", NULL, NULL };
+    char *browse[] = { "/usr/bin/open", "-a", "Finder", "--", NULL, NULL };
+    BOOL ret;
+
+    if (!wine_native_file_manager_enabled() || !path || !*path)
+        return FALSE;
+
+    attributes = GetFileAttributesW( path );
+    if (attributes == INVALID_FILE_ATTRIBUTES || (!select && !(attributes & FILE_ATTRIBUTE_DIRECTORY)))
+        return FALSE;
+
+    if (!(unix_path = wine_get_unix_file_name( path ))) return FALSE;
+    if (unix_path[0] != '/')
+    {
+        HeapFree( GetProcessHeap(), 0, unix_path );
+        return FALSE;
+    }
+    reveal[3] = browse[4] = unix_path;
+    ret = !__wine_unix_spawnvp( select ? reveal : browse, FALSE );
+    HeapFree( GetProcessHeap(), 0, unix_path );
+    return ret;
+}
+
+#endif
