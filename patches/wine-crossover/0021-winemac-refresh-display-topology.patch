@@ -1039,7 +1039,23 @@ void macdrv_displays_changed(const macdrv_event *event)
        process it (by sending it to the desktop window). */
     if (event->displays_changed.activating ||
         NtUserGetWindowThread(hwnd, NULL) == GetCurrentThreadId())
+    {
         NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
+
+        /* The desktop refresh updates the shared monitor cache, but does not
+           notify application windows. Only its owner broadcasts the native
+           change; activation merely synchronizes the activated process. */
+        if (!event->displays_changed.activating)
+        {
+            DEVMODEW mode = { .dmSize = sizeof(mode) };
+
+            if (!NtUserEnumDisplaySettings(NULL, ENUM_CURRENT_SETTINGS, &mode, 0))
+                return;
+            NtUserMessageCall(HWND_BROADCAST, WM_DISPLAYCHANGE, mode.dmBitsPerPel,
+                              MAKELPARAM(mode.dmPelsWidth, mode.dmPelsHeight),
+                              NULL, NtUserSendNotifyMessage, FALSE);
+        }
+    }
