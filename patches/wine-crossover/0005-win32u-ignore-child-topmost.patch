diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -4233,2 +4233,10 @@ BOOL WINAPI NtUserSetWindowPos( HWND hwnd, HWND after, INT x, INT y, INT cx, INT cy, UINT flags )
+    /* Windows accepts HWND_TOPMOST / HWND_NOTOPMOST for a child window, but
+     * leaves its position and size unchanged and sends no WINDOWPOS messages.
+     * Applying the move instead makes SOLIDWORKS' PropertyManager repeatedly
+     * shrink its transparent divider labels while painting. */
+    if (!(flags & SWP_NOZORDER) && (after == HWND_TOPMOST || after == HWND_NOTOPMOST) &&
+        (get_window_long( hwnd, GWL_STYLE ) & (WS_CHILD | WS_POPUP)) == WS_CHILD)
+        return TRUE;
+
     winpos.hwnd = get_full_window_handle( hwnd );
     winpos.hwndInsertAfter = get_full_window_handle( after );
