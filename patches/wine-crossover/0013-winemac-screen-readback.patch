+static void free_screen_bits(struct gdi_image_bits *bits)
+{
+    free(bits->ptr);
+}
+
+static DWORD macdrv_GetImage(PHYSDEV dev, BITMAPINFO *info,
+                            struct gdi_image_bits *bits, struct bitblt_coords *src)
+{
+    CGImageRef image;
+    CGContextRef context;
+    CGColorSpaceRef color_space;
+    CGRect rect;
+    int width, height;
+    void *data;
+
+    if (NtUserWindowFromDC(dev->hdc) != NtUserGetDesktopWindow())
+    {
+        dev = GET_NEXT_PHYSDEV(dev, pGetImage);
+        return dev->funcs->pGetImage(dev, info, bits, src);
+    }
+
+    memset(&info->bmiHeader, 0, sizeof(info->bmiHeader));
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    if (!bits) return ERROR_SUCCESS;
+
+    width = src->visrect.right - src->visrect.left;
+    height = src->visrect.bottom - src->visrect.top;
+    if (width <= 0 || height <= 0 || (size_t)width * height > UINT_MAX / 4)
+        return ERROR_INVALID_PARAMETER;
 
+    rect = cgrect_mac_from_win(cgrect_from_rect(src->visrect));
+    image = macdrv_copy_screen_image(rect);
+    if (!image) return ERROR_NOT_SUPPORTED;
 
+    data = calloc(height, (size_t)width * 4);
+    color_space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    context = data && color_space ? CGBitmapContextCreate(data, width, height, 8, (size_t)width * 4,
+                                         color_space, kCGBitmapByteOrder32Little | kCGImageAlphaNoneSkipFirst) : NULL;
+    if (color_space) CGColorSpaceRelease(color_space);
+    if (!context)
+    {
+        CGImageRelease(image);
+        free(data);
+        return ERROR_OUTOFMEMORY;
+    }
+    CGContextSetInterpolationQuality(context, kCGInterpolationNone);
+    CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+    CGContextRelease(context);
+    CGImageRelease(image);
+
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = -height;
+    info->bmiHeader.biSizeImage = (size_t)width * height * 4;
+    bits->ptr = data;
+    bits->is_copy = TRUE;
+    bits->free = free_screen_bits;
+    bits->param = NULL;
+    src->x -= src->visrect.left;
+    src->y -= src->visrect.top;
+    OffsetRect(&src->visrect, -src->visrect.left, -src->visrect.top);
+    TRACE("screen capture %s %dx%d\n", wine_dbgstr_cgrect(rect), width, height);
+    return ERROR_SUCCESS;
+}
