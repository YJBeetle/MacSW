+/***********************************************************************
+ *              macdrv_copy_screen_image
+ */
+/* Keep host capture on the Cocoa thread, not the Windows thread's small stack.
+ * Resolve dynamically as in the dock snapshot path, since newer SDKs hide
+ * the legacy declarations.  Do not manufacture pixels if capture is denied. */
+CGImageRef macdrv_copy_screen_image(CGRect rect)
+{
+    static CGImageRef (*capture)(CGRect, CGWindowListOption, CGWindowID, CGWindowImageOption);
+    static dispatch_once_t once;
+    __block CGImageRef image = NULL;
+
+    dispatch_once(&once, ^{
+        void *library = dlopen("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics", RTLD_LAZY | RTLD_LOCAL);
+        if (library) capture = dlsym(library, "CGWindowListCreateImage");
+    });
+    if (!capture) return NULL;
+
+    OnMainThread(^{
+        @autoreleasepool {
+            /* A single Wine pixel may cover half a host point in Retina mode.
+             * Capture integral host bounds, then crop in backing pixels. */
+            CGRect bounds = CGRectIntegral(rect);
+            image = capture(bounds, kCGWindowListOptionOnScreenOnly, kCGNullWindowID,
+                            kCGWindowImageBoundsIgnoreFraming | kCGWindowImageBestResolution);
+            if (image && !CGRectEqualToRect(bounds, rect))
+            {
+                CGFloat sx = CGImageGetWidth(image) / bounds.size.width;
+                CGFloat sy = CGImageGetHeight(image) / bounds.size.height;
+                CGRect crop = CGRectMake((rect.origin.x - bounds.origin.x) * sx,
+                                         (rect.origin.y - bounds.origin.y) * sy,
+                                         rect.size.width * sx, rect.size.height * sy);
+                CGImageRef cropped = CGImageCreateWithImageInRect(image, crop);
+                CGImageRelease(image);
+                image = cropped;
+            }
+        }
+    });
+    return image;
+}
