+static void delete_bitmap_buffers(struct gl_drawable *gl)
+{
+    if (gl->base.draw_fbo) pglDeleteFramebuffersEXT(1, &gl->base.draw_fbo);
+    if (gl->color_buffer) pglDeleteRenderbuffersEXT(1, &gl->color_buffer);
+    if (gl->depth_buffer) pglDeleteRenderbuffersEXT(1, &gl->depth_buffer);
+    gl->base.draw_fbo = gl->base.read_fbo = 0;
+    gl->color_buffer = gl->depth_buffer = 0;
+}
+
+static BOOL create_bitmap_drawable(int format, GLsizei width, GLsizei height, struct opengl_drawable **drawable)
+{
+    CGLContextObj previous = CGLGetCurrentContext();
+    struct gl_drawable *gl;
+    GLenum status = 0;
+
+    if (!bitmap_context || width <= 0 || height <= 0 || width > bitmap_max_size || height > bitmap_max_size)
+        return FALSE;
+    if (!(gl = opengl_drawable_create(sizeof(*gl), &macdrv_pbuffer_funcs, format, NULL))) return FALSE;
+
+    pthread_mutex_lock(&bitmap_mutex);
+    if (CGLSetCurrentContext(bitmap_context) == kCGLNoError)
+    {
+        pglGenFramebuffersEXT(1, &gl->base.draw_fbo);
+        pglBindFramebufferEXT(GL_FRAMEBUFFER_EXT, gl->base.draw_fbo);
+        pglGenRenderbuffersEXT(1, &gl->color_buffer);
+        pglBindRenderbufferEXT(GL_RENDERBUFFER_EXT, gl->color_buffer);
+        pglRenderbufferStorageEXT(GL_RENDERBUFFER_EXT, GL_RGBA8, width, height);
+        pglFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER_EXT, gl->color_buffer);
+        pglGenRenderbuffersEXT(1, &gl->depth_buffer);
+        pglBindRenderbufferEXT(GL_RENDERBUFFER_EXT, gl->depth_buffer);
+        pglRenderbufferStorageEXT(GL_RENDERBUFFER_EXT, GL_DEPTH24_STENCIL8_EXT, width, height);
+        pglFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER_EXT, gl->depth_buffer);
+        pglFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER_EXT, gl->depth_buffer);
+        funcs->p_glDrawBuffer(GL_COLOR_ATTACHMENT0);
+        funcs->p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+        if (gl->base.draw_fbo && gl->color_buffer && gl->depth_buffer)
+            status = pglCheckFramebufferStatusEXT(GL_FRAMEBUFFER_EXT);
+        if (status != GL_FRAMEBUFFER_COMPLETE_EXT) delete_bitmap_buffers(gl);
+        pglBindFramebufferEXT(GL_FRAMEBUFFER_EXT, 0);
+        pglBindRenderbufferEXT(GL_RENDERBUFFER_EXT, 0);
+    }
+    CGLSetCurrentContext(previous);
+    pthread_mutex_unlock(&bitmap_mutex);
+
+    if (status != GL_FRAMEBUFFER_COMPLETE_EXT)
+    {
+        WARN("Failed to create bitmap framebuffer %dx%d, status %#x\n", width, height, status);
+        opengl_drawable_release(&gl->base);
+        return FALSE;
+    }
+
+    gl->base.read_fbo = gl->base.draw_fbo;
+    gl->base.virtual_size.cx = width;
+    gl->base.virtual_size.cy = height;
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT_LEFT, GL_COLOR_ATTACHMENT0);
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT, GL_COLOR_ATTACHMENT0);
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT_AND_BACK, GL_COLOR_ATTACHMENT0);
+    *drawable = &gl->base;
+    TRACE("Created bitmap framebuffer %u, %dx%d, format %d\n", gl->base.draw_fbo, width, height, format);
+    return TRUE;
+}
